diff --git a/arm/Android.bp b/arm/Android.bp
index 9eb17be..8ac9ea5 100644
--- a/arm/Android.bp
+++ b/arm/Android.bp
@@ -80,10 +80,3 @@ android_app_import {
     },
     product_specific: true,
 }
-
-cc_prebuilt_library_shared {
-    name: "libjni_latinimegoogle",
-    srcs: ["proprietary/product/lib/libjni_latinimegoogle.so"],
-    prefer: true,
-    product_specific: true,
-}
diff --git a/arm/arm-vendor.mk b/arm/arm-vendor.mk
index 1ad7ba6..4e559d2 100644
--- a/arm/arm-vendor.mk
+++ b/arm/arm-vendor.mk
@@ -6,8 +6,7 @@ PRODUCT_SOONG_NAMESPACES += \

 PRODUCT_PACKAGES += \
     GmsCore \
-    Phonesky \
-    libjni_latinimegoogle
+    Phonesky

 ifeq ($(TARGET_IS_GROUPER),)
 PRODUCT_PACKAGES += \
