diff --git a/Ulefone/ultra28-SystemUI/Android.mk b/Ulefone/ultra28-SystemUI/Android.mk
new file mode 100644
index 0000000..db0def9
--- /dev/null
+++ b/Ulefone/ultra28-SystemUI/Android.mk
@@ -0,0 +1,8 @@
+LOCAL_PATH := $(call my-dir)
+include $(CLEAR_VARS)
+LOCAL_MODULE_TAGS := optional
+LOCAL_PACKAGE_NAME := treble-overlay-ulefone-ultra28-systemui
+LOCAL_MODULE_PATH := $(TARGET_OUT_PRODUCT)/overlay
+LOCAL_IS_RUNTIME_RESOURCE_OVERLAY := true
+LOCAL_PRIVATE_PLATFORM_APIS := true
+include $(BUILD_PACKAGE)
diff --git a/Ulefone/ultra28-SystemUI/AndroidManifest.xml b/Ulefone/ultra28-SystemUI/AndroidManifest.xml
new file mode 100644
index 0000000..32a3aad
--- /dev/null
+++ b/Ulefone/ultra28-SystemUI/AndroidManifest.xml
@@ -0,0 +1,10 @@
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+        package="me.phh.treble.overlay.ulefone.ultra28.systemui"
+        android:versionCode="1"
+        android:versionName="1.0">
+        <overlay android:targetPackage="com.android.systemui"
+                android:requiredSystemPropertyName="ro.vendor.build.fingerprint"
+                android:requiredSystemPropertyValue="+Ulefone/GQ5011AF1*"
+                android:priority="999"
+                android:isStatic="true" />
+</manifest>
