Subject: [PATCH 2/2] Add Ulefone 28 Ultra overlay

---
 Ulefone/ultra28/Android.mk                |  8 ++
 Ulefone/ultra28/AndroidManifest.xml       |  4 +
 Ulefone/ultra28/res/values/bools.xml      |  8 ++
 Ulefone/ultra28/res/values/integers.xml   |  5 ++
 Ulefone/ultra28/res/xml/power_profile.xml | 90 +++++++++++++++++++++++
 overlay.mk                                |  1 +
 6 files changed, 116 insertions(+)
 create mode 100644 Ulefone/ultra28/Android.mk
 create mode 100644 Ulefone/ultra28/AndroidManifest.xml
 create mode 100644 Ulefone/ultra28/res/values/bools.xml
 create mode 100644 Ulefone/ultra28/res/values/integers.xml
 create mode 100644 Ulefone/ultra28/res/xml/power_profile.xml

diff --git a/Ulefone/ultra28/Android.mk b/Ulefone/ultra28/Android.mk
new file mode 100644
index 0000000..f6b416e
--- /dev/null
+++ b/Ulefone/ultra28/Android.mk
@@ -0,0 +1,8 @@
+LOCAL_PATH := $(call my-dir)
+include $(CLEAR_VARS)
+LOCAL_MODULE_TAGS := optional
+LOCAL_PACKAGE_NAME := treble-overlay-ulefone-ultra28
+LOCAL_MODULE_PATH := $(TARGET_OUT_PRODUCT)/overlay
+LOCAL_IS_RUNTIME_RESOURCE_OVERLAY := true
+LOCAL_PRIVATE_PLATFORM_APIS := true
+include $(BUILD_PACKAGE)
diff --git a/Ulefone/ultra28/AndroidManifest.xml b/Ulefone/ultra28/AndroidManifest.xml
new file mode 100644
index 0000000..ae2f142
--- /dev/null
+++ b/Ulefone/ultra28/AndroidManifest.xml
@@ -0,0 +1,4 @@
+<?xml version="1.0" encoding="utf-8" standalone="no"?>
+<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="me.phh.treble.overlay.ulefone.ultra28" platformBuildVersionCode="27" platformBuildVersionName="8.1.0">
+    <overlay android:isStatic="true" android:priority="999" android:requiredSystemPropertyName="ro.vendor.build.fingerprint" android:requiredSystemPropertyValue="+Ulefone/GQ5011AF1*" android:targetPackage="android"/>
+</manifest>
diff --git a/Ulefone/ultra28/res/values/bools.xml b/Ulefone/ultra28/res/values/bools.xml
new file mode 100644
index 0000000..cad20ec
--- /dev/null
+++ b/Ulefone/ultra28/res/values/bools.xml
@@ -0,0 +1,8 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <bool name="config_displayBlanksAfterDoze">true</bool>
+    <bool name="config_dozeAfterScreenOff">true</bool>
+    <bool name="config_dozeAlwaysOnEnabled">true</bool>
+    <bool name="config_powerDecoupleAutoSuspendModeFromDisplay">true</bool>
+    <bool name="config_powerDecoupleInteractiveModeFromDisplay">true</bool>
+</resources>
diff --git a/Ulefone/ultra28/res/values/integers.xml b/Ulefone/ultra28/res/values/integers.xml
